{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist/electron"
  },
  "include": ["electron/**/*.ts", "src/domain/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["**/*.test.ts", "src/domain/testUtils.ts"]
}
